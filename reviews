<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- React + ReactDOM -->
    <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>

    <!-- Babel -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

    <!-- Firebase -->
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js"></script>
</head>
<body>
     <div id="root"></div>

     <script type="text/babel">
        const { useState, useEffect } = React;

        // ========================================
        // firebase configuration
        // ========================================
        const firebaseConfig = {
            apiKey: "AIzaSyA5gXGbM9TQCip1f27904_HlJNnWVCssA8",
            authDomain: "waffenrecht-guck.firebaseapp.com",
            projectId: "waffenrecht-guck",
            storageBucket: "waffenrecht-guck.firebasestorage.app",
            messagingSenderId: "280006919738",
            appId: "1:280006919738:web:ec829fb8ad0cba2dcb5703",
            measurementId: "G-2NVQLD5S74"
        };

        // Firebase initialisieren
        firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();

        // Icons als SVG-Komponenten
        const Plus = () => (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
        );

        const Trash2 = () => (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                <line x1="10" y1="11" x2="10" y2="17"></line>
                <line x1="14" y1="11" x2="14" y2="17"></line>
            </svg>
        );

        const Save = () => (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
        );

        const Star = ({ filled }) => (
            <svg width="20" height="20" viewBox="0 0 24 24" fill={filled ? "currentColor" : "none"} stroke="currentColor" strokeWidth="2">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
        );
     function CourseCMSAdmin(){
        const [newReview, setNewReview] = useState({
                name: '',
                initials: '',
                rating: 5,
                text: '',
                date: new Date().toLocaleDateString('de-DE')
            });
        const [reviews, setReviews] = useState([]);
        const [loading, setLoading] = useState(false);
        const [saveMessage, setSaveMessage] = useState('');
        
        const loadData = async () => {
            setLoading(true);
            try {
                // load reviews
                const reviewsSnapshot = await db.collection('reviews').doc('reviewList').get();
                    if (reviewsSnapshot.exists) {
                        setReviews(reviewsSnapshot.data().list || []);
                    } else {
                        const initialReviews = [
                            { name: 'Max Mustermann', initials: 'MM', rating: 5, text: 'Sehr kompetenter Kursleiter! Habe meine Prüfung auf Anhieb bestanden und fühle mich jetzt sicher im Umgang mit Waffen.', date: '15.02.2025' },
                            { name: 'Erika Test', initials: 'ET', rating: 5, text: 'Das Training war perfekt auf meine Bedürfnisse zugeschnitten. Super geduldige Erklärungen und professionelle Atmosphäre.', date: '28.01.2025' },
                            { name: 'Jürgen Meyer', initials: 'JM', rating: 4, text: 'Guter Kurs, allerdings etwas schnell für Anfänger. Trotzdem alles wichtige vermittelt bekommen.', date: '10.01.2025' }
                        ];
                        await db.collection('reviews').doc('reviewList').set({ list: initialReviews });
                        setReviews(initialReviews);
                    }
                 } catch (error) {
                console.error('Fehler beim Laden:', error);
                    showSaveMessage('Fehler beim Laden der Daten!');
                } finally {
                    setLoading(false);
                }
            };
        }
        // handle reviews
        const handleAddReview = async () => { 
            if (!newReview.name || !newReview.initials || !newReview.text){
             alert('Bitte alle Felder ausfüllen : )');
            return;
            }
            const reviewToAdd= {
                    ...newReview,
                    date: new Date().toLocaleDateString('de-DE')
                };
            const updatedReviews = [reviewToAdd, ...reviews];
                setReviews(updatedReviews);
                await db.collection('reviews').doc('reviewList').set({list: updatedReviews});

                setNewReview({name: '', initials: '', rating: 5, text:'', date:''});
                showSaveMessage('Bewertung hinzugefügt')
        };
        if (loading) {
                return (
                    <div className="min-h-screen bg-gradient-to-br from-green-50 to-green-100 flex items-center justify-center">
                        <div className="text-center">
                            <div className="animate-spin rounded-full h-16 w-16 border-b-4 border-green-700 mx-auto mb-4"></div>
                            <p className="text-green-800 font-medium">Daten werden geladen...</p>
                        </div>
                    </div>
                );
            }
        return (
        <div className="min-h-screen bg-gradient-to-br
            from-green-50 to-green-100 p-4">
            <div className="max-w-4xl mx-auto">

                {/* Seitentitel */}
                <div className="bg-white rounded-lg shadow-lg p-6 mb-6">
                    <h1 className="text-3xl font-bold text-green-800 mb-2">
                        Bewertungen
                    </h1>
                    <p className="text-gray-600">
                        Teile deine Erfahrungen mit uns
                    </p>

                    {/* Erfolgsmeldung – nur sichtbar wenn saveMessage nicht leer */}
                    {saveMessage && (
                        <div className="mt-4 bg-green-100 border
                            border-green-400 text-green-700 px-4 py-3 rounded">
                            {saveMessage}
                        </div>
                    )}
                </div>

                {/* Neue Bewertung schreiben */}
                <div className="bg-white rounded-lg shadow-lg p-6 mb-6">
                    <h2 className="text-2xl font-bold text-green-800 mb-4">
                        Neue Bewertung hinzufügen
                    </h2>

                    <div className="space-y-4 mb-4">

                        {/* Name + Initialen nebeneinander */}
                        <div className="grid md:grid-cols-2 gap-4">
                            <div>
                                <label className="block text-gray-700
                                    font-medium mb-2">
                                    Name
                                </label>
                                <input
                                    type="text"
                                    value={newReview.name}
                                    onChange={(e) => setNewReview({
                                        ...newReview, name: e.target.value
                                    })}
                                    className="w-full px-4 py-2 border
                                        border-gray-300 rounded-lg
                                        focus:outline-none
                                        focus:ring-2 focus:ring-green-600"
                                    placeholder="Dein Name"
                                />
                            </div>
                            <div>
                                <label className="block text-gray-700
                                    font-medium mb-2">
                                    Initialen (2 Buchstaben)
                                </label>
                                <input
                                    type="text"
                                    maxLength="2"
                                    value={newReview.initials}
                                    onChange={(e) => setNewReview({
                                        ...newReview,
                                        initials: e.target.value.toUpperCase()
                                    })}
                                    className="w-full px-4 py-2 border
                                        border-gray-300 rounded-lg
                                        focus:outline-none
                                        focus:ring-2 focus:ring-green-600"
                                    placeholder="z.B. MM"
                                />
                            </div>
                        </div>

                        {/* Sterne-Auswahl */}
                        <div>
                            <label className="block text-gray-700
                                font-medium mb-2">
                                Bewertung
                            </label>
                            <div className="flex gap-2 items-center">
                                {[1, 2, 3, 4, 5].map((star) => (
                                    <button
                                        key={star}
                                        onClick={() => setNewReview({
                                            ...newReview, rating: star
                                        })}
                                        className="text-yellow-500
                                            hover:scale-110 transition"
                                    >
                                        <Star filled={star <= newReview.rating} />
                                    </button>
                                ))}
                                <span className="ml-2 text-gray-700">
                                    {newReview.rating} / 5 Sterne
                                </span>
                            </div>
                        </div>

                        {/* Bewertungstext */}
                        <div>
                            <label className="block text-gray-700
                                font-medium mb-2">
                                Dein Erfahrungsbericht
                            </label>
                            <textarea
                                value={newReview.text}
                                onChange={(e) => setNewReview({
                                    ...newReview, text: e.target.value
                                })}
                                rows="4"
                                className="w-full px-4 py-2 border
                                    border-gray-300 rounded-lg
                                    focus:outline-none
                                    focus:ring-2 focus:ring-green-600"
                                placeholder="Was hat dir besonders gut gefallen?"
                            />
                        </div>
                    </div>

                    <button
                        onClick={handleAddReview}
                        className="bg-green-700 hover:bg-green-800
                            text-white py-2 px-6 rounded-lg
                            font-medium transition"
                    >
                        Bewertung absenden
                    </button>
                </div>

                {/* Alle bisherigen Bewertungen anzeigen */}
                <div className="bg-white rounded-lg shadow-lg p-6">
                    <h2 className="text-2xl font-bold text-green-800 mb-4">
                        Alle Bewertungen ({reviews.length})
                    </h2>

                    <div className="grid md:grid-cols-2 gap-4">
                        {reviews.map((review, index) => (
                            <div key={index}
                                className="border border-gray-200
                                    rounded-lg p-4">

                                {/* Avatar + Name + Sterne */}
                                <div className="flex items-center mb-3">
                                    <div className="w-12 h-12 rounded-full
                                        bg-green-700 flex items-center
                                        justify-center text-xl
                                        font-bold text-white">
                                        {review.initials}
                                    </div>
                                    <div className="ml-3">
                                        <h4 className="font-semibold
                                            text-gray-800">
                                            {review.name}
                                        </h4>
                                        <div className="flex text-yellow-500">
                                            {[1,2,3,4,5].map((star) => (
                                                <Star key={star}
                                                    filled={star <= review.rating}
                                                />
                                            ))}
                                        </div>
                                    </div>
                                </div>

                                <p className="text-gray-700 mb-2">
                                    {review.text}
                                </p>
                                <p className="text-sm text-gray-500">
                                    {review.date}
                                </p>
                            </div>
                        ))}
                    </div>

                    {/* Fallback wenn noch keine Reviews da sind */}
                    {reviews.length === 0 && (
                        <p className="text-gray-500 text-center py-8">
                            Noch keine Bewertungen vorhanden.
                            Sei der Erste!
                        </p>
                    )}
                </div>

            </div>
        </div>
        
    );
    

// App start
const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<CourseCMSAdmin />);
    
</script>
</body>
</html>
